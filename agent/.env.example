# ==========================================
# AI Triage Agent - Environment Configuration
# ==========================================

# ------------------------------------------
# LLM Provider Configuration
# ------------------------------------------
# Choose: 'vertexai' (Google Cloud Vertex AI) or 'ollama' (Local Ollama) or 'genai' (Google AI Studio)
LLM_PROVIDER=vertexai
LLM_TEMPERATURE=0.1

# --- Google Cloud Vertex AI Settings ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-pro
# If running outside GCP without gcloud ADC, point to your service account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- Alternative: Google AI Studio (API Key) ---
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-pro

# --- Alternative: Local Ollama Settings ---
# OLLAMA_HOST=localhost
# OLLAMA_MODEL=qwen3.5:9b-q8_0

# ------------------------------------------
# MCP Server Endpoints (In-Cluster or Port-Forward)
# ------------------------------------------
# When running locally with ./minikube/port-forward.sh:
GITHUB_MCP_URL=http://localhost:8080/sse
KUBERNETES_MCP_URL=http://localhost:8081/sse
GRAFANA_MCP_URL=http://localhost:8082/sse

# When running inside Minikube cluster:
# GITHUB_MCP_URL=http://mcp-github:8080/sse
# KUBERNETES_MCP_URL=http://mcp-kubernetes:8080/sse
# GRAFANA_MCP_URL=http://mcp-grafana:8080/sse
